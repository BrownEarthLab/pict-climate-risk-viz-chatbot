# -----------------------------------------------------------------------------
# Project .gitignore for pict-climate-risk-viz-chatbot
# Keep source code, lightweight reference/catalog files, and scripts in git.
# Keep generated caches, raw climate downloads, local builds, and secrets out.
# -----------------------------------------------------------------------------

# -----------------------------
# Node / JavaScript dependencies
# -----------------------------
node_modules/
frontend/node_modules/
backend/node_modules/
.npm/
.pnpm-store/
.yarn/

# -----------------------------
# Frontend/backend build outputs
# -----------------------------
frontend/dist/
dist/
build/
coverage/
.vite/

# -----------------------------
# Logs
# -----------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------
# Environment / secrets
# -----------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
secrets/

# -----------------------------
# OS / editor files
# -----------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------
# Python local/runtime files
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# -----------------------------
# Raw / large climate data
# -----------------------------
data/climate/raw/
data/climate/processed/
data/climate/intermediate/
data/climate/tmp/
data/climate/downloads/
data/climate/manifests/
*.nc
*.nc4
*.cdf
*.grib
*.grib2
*.zarr/
*.zarr.zip

# -----------------------------
# Generated backend caches
# These can still be included in a local Docker image unless also ignored in
# .dockerignore. .gitignore only controls what git tracks.
# -----------------------------
backend/cache/climate_indices/
backend/cache/tropical_cyclone/
backend/cache/admin_assets/
backend/cache/**/*.tif
backend/cache/**/*.tiff
backend/cache/**/*.vrt
backend/cache/**/*.sqlite
backend/cache/**/*.db

# Keep cache directory placeholders if you add them later
!backend/cache/.gitkeep
!backend/cache/**/.gitkeep

# -----------------------------
# Generated GIS/vector exports
# -----------------------------
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qpj
*.geojson.tmp
*.tmp.geojson

# -----------------------------
# Temporary archives / local artifacts
# -----------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# -----------------------------
# Local notebooks / scratch outputs
# -----------------------------
scratch/
tmp/
temp/
outputs/
reports/tmp/

# -----------------------------
# Docker/local runtime artifacts
# -----------------------------
.docker/
docker-compose.override.yml


data/reference/pict/*/worldpop/*.tif
data/hazards/tropical_cyclone/raw/TC_500_year.asc